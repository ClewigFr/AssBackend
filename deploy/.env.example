# Copy to .env (cp .env.example .env), fill in, and keep it secret: chmod 600 .env

# Database password, letters and digits only:  openssl rand -hex 24
POSTGRES_PASSWORD=
# Session cookie signing key:  openssl rand -hex 32
SESSION_SIGN_KEY=
# The dashboard's public address
CORS_ORIGINS=https://ass.clewig.fr
# true only while you create your account, then back to false
REGISTRATION_OPEN=false
# Days of raw page views (with session ids) to keep; older ones become views per page and per day. 0 keeps everything
RETENTION_DAYS=90
# Per-account quotas (0 = no limit). Monthly views only trigger an alert in the dashboard, they're still recorded
MAX_APPS=5
MAX_PAGES_PER_APP=30
MAX_MONTHLY_VIEWS=100000

# Cloudflare tunnel token (Zero Trust > Networks > Tunnels > your tunnel)
TUNNEL_TOKEN=

# Backups (see README.md, "Nightly backups")
# Public key from:  docker compose run --rm backup age-keygen
AGE_RECIPIENT=
B2_BUCKET=
B2_KEY_ID=
B2_APP_KEY=
# Optional: a healthchecks.io ping URL, to get an email when a backup fails or doesn't run
HEALTHCHECK_URL=
BACKUP_SCHEDULE=0 3 * * *
TZ=Europe/Paris

# Where the database lives. Move it to an SSD later with DATA_DIR=/mnt/ssd/ass
DATA_DIR=./data
